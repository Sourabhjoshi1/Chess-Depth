rules_version = '2';
// ChessDepth Academy - Firestore security rules (Student Area + Chess Lab).
// Paste this whole file into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins can switch Lab access on/off. Keep in step with `lab.admins` in _config.yml.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['joshisourabh47@gmail.com'];
    }
    // Launch offer: every signed-in user has full access until this moment.
    // Keep in step with `lab.free_until` in _config.yml (end of 21 Nov 2026, India time = 18:29:59 UTC).
    function promoActive() {
      return request.auth != null && request.time < timestamp.date(2026, 11, 21) + duration.value(18, 'h') + duration.value(30, 'm');
    }
    // A Lab member: the launch offer is running, a paid membership is active,
    // or the student has linked a ChessDepth Academy enrollment number (free forever).
    function hasLab() {
      return promoActive() || paidLab() || academyStudent();
    }
    function paidLab() {
      let s = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return request.auth != null && s.get('lab', false) == true
        && (s.get('labUntil', null) == null || s.labUntil > request.time);
    }

    // Academy student: students/{uid}.enrollment points at an enrollment number claimed by this same account.
    function academyStudent() {
      let sp = /databases/$(database)/documents/students/$(request.auth.uid);
      let no = exists(sp) ? get(sp).data.get('enrollment', '') : '';
      let ep = /databases/$(database)/documents/enrollments/$(no == '' ? '_none' : no);
      return request.auth != null && no != '' && exists(ep)
        && get(ep).data.get('claimedBy', null) == request.auth.uid
        && get(ep).data.get('active', true) == true;
    }

    // Each student's own record. Students may update their name/email/login times,
    // but never their own Lab access fields; only admins can change those.
    match /students/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['lab', 'labUntil', 'labUpdated']);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lab', 'labUntil', 'labUpdated']));
      allow list: if isAdmin();
    }

    // Academy enrollment numbers. Only admins add, edit or list them.
    // A signed-in student may claim an unclaimed, active number for themself (once);
    // after that they can read their own number, and nobody else can claim it.
    match /enrollments/{no} {
      allow read: if isAdmin() || (request.auth != null && resource.data.get('claimedBy', null) == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null
        && resource.data.get('claimedBy', null) == null
        && resource.data.get('active', true) == true
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedEmail', 'claimedAt']));
    }

    // Chess Lab progress: only the member themself, and only while their membership is active.
    match /labProgress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid && hasLab();
    }

    // Weekly leaderboard (first names only): readable by members, each member writes their own row.
    match /leaderboard/{uid} {
      allow read: if hasLab();
      allow write: if request.auth != null && request.auth.uid == uid && hasLab();
    }

    // Public reviews of the academy, coaches, courses, the Chess Lab and Shop products.
    // Anyone signed in with Google may post ONE review per item (doc id = target + "__" + uid),
    // edit or delete it. Reviews are public straight away. "verified" must match academyStudent().
    // Admins can only hide/unhide a review and add a public reply; they can't change its words or stars.
    function validReview(d) {
      return d.target is string && d.target.matches('^((coach|course|product):[a-z0-9-]{1,60}|lab|academy)$')
        && d.uid == request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 1500
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.role in ['student', 'parent', 'other']
        && d.verified == academyStudent()
        && d.updated == request.time;
    }
    match /reviews/{id} {
      allow read: if resource.data.hidden == false
        || (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if request.auth != null
        && id == request.resource.data.target + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['target', 'uid', 'name', 'rating', 'text', 'role', 'verified', 'created', 'updated', 'hidden'])
        && validReview(request.resource.data)
        && request.resource.data.created == request.time
        && request.resource.data.hidden == false;
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rating', 'text', 'role', 'verified', 'updated'])
          && validReview(request.resource.data))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'reply', 'replyAt'])
          && request.resource.data.hidden is bool
          && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 1500)));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Quiz links (Google Forms) for the Student Area: only academy students (linked enrollment number)
    // and admins can read them; only admins can add or change them.
    match /quizLinks/{id} {
      allow read: if academyStudent() || isAdmin();
      allow write: if isAdmin();
    }

    // All-time Puzzle Streak leaderboard (first names + best streak).
    match /streakBoard/{uid} {
      allow read: if hasLab();
      allow write: if request.auth != null && request.auth.uid == uid && hasLab();
    }
  }
}
